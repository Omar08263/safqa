# PostgreSQL. docker compose publishes this on localhost:5432.
DATABASE_URL=postgres://safqa:safqa@localhost:5432/safqa

# Redis. docker compose publishes this on localhost:6379.
REDIS_URL=redis://localhost:6379

# API
API_PORT=8787
API_PUBLIC_URL=http://localhost:8787
# Comma-separated. The dev server origin is allowed automatically when empty (reflect request origin).
WEB_ORIGIN=http://localhost:47321

# Change before any shared deployment. Used to sign access tokens.
AUTH_SECRET=dev-only-change-me-please-32b

# polite = live fetches that obey robots.txt and per-domain limits (no captcha bypass).
# off = worker schedules nothing.
CRAWL_MODE=polite

# Optional path to the MarkItDown CLI (default: `markitdown` on PATH).
# After a fetch, JSON-LD is still the price/title extractor. MarkItDown
# turns the HTML into compact markdown for the debate/assistant. The Docker
# image installs 0.1.7 at /opt/markitdown/bin/markitdown and sets this.
# A missing binary is skipped; the crawl does not fail.
# MARKITDOWN_BIN=markitdown

# When true, the API migrates and seeds sample deals on boot. docker compose sets this.
SEED_ON_BOOT=false

# Web Push (optional). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bot@safqa.example

# Expo push (optional). Delivery still works for Expo tokens without this; set it for higher throughput.
EXPO_ACCESS_TOKEN=

# Telegram notifier (optional channel).
TELEGRAM_BOT_TOKEN=

# Google OAuth. All three are required before /api/auth/oauth/google redirects.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8787/api/auth/oauth/google/callback

# Sign in with Apple. Left unset, the route returns oauth_not_configured.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URL=http://localhost:8787/api/auth/oauth/apple/callback

# Amazon Creators API (affiliate) for amazon.eg. When unset, the amazon.eg adapter
# stays on the best-effort public HTML / JSON-LD path and never tries to evade bot checks.
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_PARTNER_TAG=
AMAZON_CREATORS_MARKETPLACE=www.amazon.eg

# Vite. Empty uses the dev-server proxy (same origin /api).
VITE_API_URL=

# One ranked chain for every role, strongest first. provider:model, comma-separated.
# Unset LLM_CHAIN uses this default. Entries with no key are skipped. mock stays last.
# LLM_CHAIN=gemini:gemini-3.8-flash,nvidia:nvidia/nemotron-3-ultra-550b-a55b,gemini:gemini-3.7-flash,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free,groq:openai/gpt-oss-120b,gemini:gemini-3-flash-preview,nvidia:deepseek-ai/deepseek-v4.1-flash,groq:qwen/qwen3.8-27b,openrouter:nvidia/nemotron-3.5-super-vl:free,gemini:gemini-2.5-flash,groq:openai/gpt-oss-20b,openrouter:openrouter/free,ollama,mock
# Default for every agent role is the chain above, starting with Gemini on the AI Studio free tier.
# Get a key: https://aistudio.google.com/apikey (do not turn billing on).
# Live quotas: https://aistudio.google.com/rate-limit
# GEMINI_RPM / GEMINI_RPD default to 5 and 20, the free-project numbers read in
# AI Studio on 21 Oct 2026 for gemini-3.8-flash. Google does not publish a fixed
# quota and says the live numbers can change, so set these to your project.
# LLM_PROVIDER=free uses LLM_CHAIN. LLM_PROVIDER=mock skips the network entirely.
# Per role: LLM_ROLE_HISTORIAN=xai:grok-4.7 or LLM_ROLE_JUDGE=openrouter:google/gemma-4-31b-it:free
LLM_PROVIDER=free
# Total debate budget. 2,500 is kept for the judge, and each other role is capped
# so a long historian/market/trust pass cannot skip the verdict.
LLM_DEBATE_TOKEN_BUDGET=16000
LLM_DEBATE_ROLE_TOKEN_CAP=2500
LLM_DEBATE_JUDGE_RESERVE=2500

# OpenRouter. One key, many models. Default model is the free router.
# Free as of Nov 2026: openrouter/free and any model id ending in :free are $0,
# about 20 requests/minute and 50/day until you buy credits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# 50 free requests/day shared by these ids. openrouter/free often 429s.
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free
OPENROUTER_RPD=50

# Google Gemini. GEMINI_API_KEY wins if both are set.
# Free as of the 30 Oct 2026 pricing page: gemini-3.8-flash input and output are free of charge
# on the free tier (project quotas in AI Studio; prompts may train Google products).
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Listed on the admin provider row. Call order is LLM_CHAIN, not this list.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3-flash-preview,gemini-2.5-flash
# Observed free-project pace for gemini-3.8-flash (5/minute, 20/day). Match AI Studio.
GEMINI_RPM=5
GEMINI_RPD=20

# Local Ollama. No key. Leave the URL empty and the app uses http://localhost:11434/v1.
# Inside Docker Compose the default is http://host.docker.internal:11434/v1.
# Set OLLAMA_DISABLED=1 to skip it.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
OLLAMA_API_KEY=
OLLAMA_DISABLED=

# xAI Grok. Ready, not the default. No free tier (prepaid credits). Flagship is grok-4.7.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# Groq. Verified on this key: the three models below. Free plan is about
# 30 requests/minute and 1,000 requests/day per model (2 Nov 2026).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GROQ_RPD=1000

# NVIDIA NIM. OpenAI-compatible. Trial access for Developer Program members is for
# prototyping, not production. Verified on this key: nvidia/nemotron-3-ultra-550b-a55b.
# Not routed: deepseek-ai/deepseek-v4.1-flash (timed out past 100s) and
# moonshotai/kimi-k2.6 (HTTP 404 on this account). Qwen stays on Groq.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b
# Set only if you want a hard daily cap. NVIDIA does not publish one number we enforce.
NVIDIA_RPD=

# Per-request timeout. On error, 429, 503, or timeout the call moves down LLM_CHAIN.
# A failed model stays open for the cooldown, then one call re-probes it.
LLM_TIMEOUT_MS=30000
LLM_CIRCUIT_COOLDOWN_MS=60000
LLM_PROBE_MS=20000

# Cohere trial: about 1,000 calls/month. Not allowed for production.
COHERE_API_KEY=
COHERE_MODEL=command-r

# Paid providers. No ongoing free chat tier as of 2 Nov 2026.
# OpenAI: prepaid credits (Moderation is free; chat is not).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Anthropic: a small unpublished signup credit, then paid.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# DeepSeek official API: optional paid slot. Not the NIM deepseek model.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Together: no free trial; access starts with a credit purchase.
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Optional per-role override. Format is provider or provider:model.
LLM_ROLE_HISTORIAN=
LLM_ROLE_MARKET=
LLM_ROLE_TRUST=
LLM_ROLE_SKEPTIC=
LLM_ROLE_JUDGE=
LLM_ROLE_ASSISTANT=

# Admin dashboard. Required for /admin and GET /api/admin/overview.
ADMIN_TOKEN=dev-admin

# Optional image prefix. Product images are rewritten as ${IMAGE_CDN_BASE}/${encoded url}.
IMAGE_CDN_BASE=

# Optional affiliate tags. Format: amazon-eg:tag=safqa-21,noon:utm_source=safqa
AFFILIATE_TAGS=

# How many crawl jobs one worker process runs at once. Run more worker containers to scale out.
WORKER_CONCURRENCY=2

# OpenTelemetry. When set, spans are POSTed to ${OTEL_EXPORTER_OTLP_ENDPOINT}/v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Telegram webhook shared secret. The bot token above is still required to send.
TELEGRAM_WEBHOOK_SECRET=
