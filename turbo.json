{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "API_PUBLIC_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "XAI_API_KEY",
    "XAI_MODEL",
    "XAI_BASE_URL",
    "LLM_PROVIDER",
    "LLM_BASE_URL",
    "LLM_API_KEY",
    "LLM_MODEL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "cache": false
    },
    "migrate": {
      "cache": false
    },
    "seed": {
      "cache": false
    }
  }
}
