{
  "expo": {
    "name": "صفقة",
    "slug": "safqa",
    "version": "5.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "safqa",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3EEE4",
    "primaryColor": "#0E6B52",
    "description": "صفقة: أسعار حقيقية من المتاجر المصرية كل يوم، كاشف الخصومات الوهمية، ومراقبة الأسعار بتنبيهات.",
    "extra": {
      "snapshotUrl": "https://safqaeg.pages.dev/demo/snapshot.json",
      "siteUrl": "https://safqaeg.pages.dev",
      "supportsRTL": true,
      "forcesRTL": true,
      "apiUrl": "https://safqa-api.safqaeg.workers.dev",
      "telegramUrl": "https://t.me/SafqaDealsBot"
    },
    "android": {
      "package": "app.safqa.mobile",
      "versionCode": 51,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#0A5240"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "safqa"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.safqa.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0A5240",
          "dark": {
            "backgroundColor": "#0A0908"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E6B52"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "./plugins/with-force-rtl.js",
      "./plugins/with-release-signing.js"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
