{
  "expo": {
    "name": "صفقة",
    "slug": "safqa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safqa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "apiUrl": "http://localhost:8787"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.safqa.mobile"
    },
    "android": {
      "package": "app.safqa.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1C1915",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#c9840a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
