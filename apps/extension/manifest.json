{
  "manifest_version": 3,
  "name": "صفقة Safqa",
  "version": "5.0.0",
  "description": "Safqa: see cross-store Egyptian prices for the product page you are viewing, and optionally share its price. Reads only the public schema.org data of your current tab; never bypasses store bot checks.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "صفقة"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://safqa-api.safqaeg.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.eg/*",
        "https://www.noon.com/*",
        "https://www.jumia.com.eg/*",
        "https://btech.com/*",
        "https://2b.com.eg/*",
        "https://www.carrefour.com.eg/*",
        "https://www.elarabygroup.com/*",
        "https://www.hyperone.com.eg/*",
        "https://www.compumarts.com/*",
        "https://www.sigma-computer.com/*",
        "https://elbadrgroupeg.store/*",
        "https://tradelinestores.com/*",
        "https://kimostore.net/*",
        "https://www.kimostore.net/*",
        "https://www.rayashop.com/*",
        "https://rayashop.com/*",
        "https://www.2b.com.eg/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}